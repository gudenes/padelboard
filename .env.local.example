# .env.local.example — copy to .env.local and fill in values.

NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# For the nightly draft-cleanup cron (generate with: openssl rand -hex 32)
CRON_SECRET=

# Claude API for AI palette generation from tournament logos
ANTHROPIC_API_KEY=

# Public origin of the site, used for metadataBase (hreflang, Open Graph).
# Needs the NEXT_PUBLIC_ prefix: the pages under [locale] are prerendered
# (generateStaticParams), so the value is inlined at build time.
NEXT_PUBLIC_SITE_URL=https://padelboard.padellabs.tech
